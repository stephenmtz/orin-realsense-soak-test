{
  "title": "Fridge Thermal Control",
  "uid": "fridge-thermal-control",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Temperature (C)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"fridge\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"hts221\")\n  |> filter(fn: (r) => r._field == \"temperature_c\")",
          "datasource": { "type": "influxdb", "uid": "InfluxDB" }
        }
      ]
    },
    {
      "id": 2,
      "title": "Humidity (%RH)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": {
          "unit": "humidity",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"fridge\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"hts221\")\n  |> filter(fn: (r) => r._field == \"humidity_pct\")",
          "datasource": { "type": "influxdb", "uid": "InfluxDB" }
        }
      ]
    },
    {
      "id": 3,
      "title": "Current Temperature",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 9 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": { "unit": "celsius" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"fridge\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"hts221\")\n  |> filter(fn: (r) => r._field == \"temperature_c\")\n  |> last()",
          "datasource": { "type": "influxdb", "uid": "InfluxDB" }
        }
      ]
    },
    {
      "id": 4,
      "title": "Current Humidity",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 9 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": { "unit": "humidity" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"fridge\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"hts221\")\n  |> filter(fn: (r) => r._field == \"humidity_pct\")\n  |> last()",
          "datasource": { "type": "influxdb", "uid": "InfluxDB" }
        }
      ]
    }
  ]
}
